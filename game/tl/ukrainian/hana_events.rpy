
# game/game/hana_events.rpy:16
translate ukrainian hana_house_9b244468:

    # t "{size=+5}I should go and talk to Yui, it's very strange that they haven't fixed the entrance yet..."
    t "{size=+5}I should go and talk to Yui, it's very strange that they haven't fixed the entrance yet..."

# game/game/hana_events.rpy:95
translate ukrainian hana_talk_7745131c:

    # a "I didn't expect to see you here so soon."
    a "Не очікувала тебе так швидко побачити тут."

# game/game/hana_events.rpy:96
translate ukrainian hana_talk_acd81eee:

    # mc "Yeah, I'm already feeling better."
    mc "Так, мені вже краще."

# game/game/hana_events.rpy:97
translate ukrainian hana_talk_52f1bbd2:

    # mc "Yui told me you were the one who saved my life."
    mc "Юї розповіла, що це саме ти мене на ноги поставила."

# game/game/hana_events.rpy:99
translate ukrainian hana_talk_c52ce9e2:

    # mc "So I came to thank you, {w}umm..."
    mc "Тож я прийшов тобі подякувати, {w}умм..."

# game/game/hana_events.rpy:100
translate ukrainian hana_talk_9bf150be:

    # a "Hana."
    a "Хана."

# game/game/hana_events.rpy:102
translate ukrainian hana_talk_12db36b4:

    # h "My name is Hana."
    h "Мене звати Хана."

# game/game/hana_events.rpy:104
translate ukrainian hana_talk_3fba56e7:

    # mc "Thank you, Hana... for saving my life."
    mc "Дякую тобі, Хано... за те, що урятувала мені життя."

# game/game/hana_events.rpy:106
translate ukrainian hana_talk_8edac5d5:

    # h "I can tell you're a good person, [mc]."
    h "Одразу видно, що ти хороша людина, [mc]."

# game/game/hana_events.rpy:108
translate ukrainian hana_talk_78153510:

    # mc "Wait... how do you know my name?"
    mc "Стривай... коли це я встиг представитися?"

# game/game/hana_events.rpy:110
translate ukrainian hana_talk_8ac2e955:

    # h "Well, when Yui showed up with a dying man and a slave girl who wouldn't stop screaming your name..."
    h "Ну, коли Юї з'явилася з хлопцем, що вже збирався коней двинути, та малою рабинею, яка постійно кричала твоє ім'я..."

# game/game/hana_events.rpy:112
translate ukrainian hana_talk_9052af24:

    # h "It kind of sticks."
    h "Якось важко не запам'ятати."

# game/game/hana_events.rpy:113
translate ukrainian hana_talk_b19e6511:

    # mc "Hahaha, yeah, I guess you're right."
    mc "Хахаха, згоден. Мабуть, ти маєш рацію."

# game/game/hana_events.rpy:115
translate ukrainian hana_talk_c7f7979e:

    # h "Hmm... I thought someone who owns a demon would act a bit differently."
    h "Гмм... Гадала, власник демона поводитиметься інакше."

# game/game/hana_events.rpy:117
translate ukrainian hana_talk_b2b9e19d:

    # mc "What do you mean?"
    mc "Про що це ти?"

# game/game/hana_events.rpy:118
translate ukrainian hana_talk_f15666f8:

    # mc "Now that you mention it, ever since I came to this wor— {w}I mean, village... everyone's been staring at me like I'm some kind of weirdo."
    mc "Тепер, коли ти згадала, відтоді, як я прибув у цей сві— {w}тобто селище... усі витріщаються на мене, ніби я якийсь дивак."

# game/game/hana_events.rpy:119
translate ukrainian hana_talk_e1a5d186:

    # h "I figured you weren't from around here."
    h "Я здогадалася, що ти не з тутешніх земель."

# game/game/hana_events.rpy:121
translate ukrainian hana_talk_a828d37b:

    # mc "Ah, no... I come from pretty far away."
    mc "Ах, так... Я прибув з досить далеких країв."

# game/game/hana_events.rpy:123
translate ukrainian hana_talk_e59e05c1:

    # h "Yeah, I noticed something was off when I saw how concerned a \"slave\" was for her owner."
    h "Ага, я одразу запідозрила неладне, коли побачила, як «рабиня» настільки переймалася за власного господаря."

# game/game/hana_events.rpy:125
translate ukrainian hana_talk_f698eed8:

    # mc "Her name's Ryoko."
    mc "Її звати Рьоко."

# game/game/hana_events.rpy:126
translate ukrainian hana_talk_13b3789d:

    # mc "And she's not a slave... {w}not anymore."
    mc "І вона не рабиня... {w}відтепер точно."

# game/game/hana_events.rpy:128
translate ukrainian hana_talk_fb386c35:

    # h "Hmm..."
    h "Гмм..."

# game/game/hana_events.rpy:130
translate ukrainian hana_talk_d8a80b0b:

    # h "Well, I think it's time for a checkup."
    h "Ну, думаю, настав час для обстеження."

# game/game/hana_events.rpy:131
translate ukrainian hana_talk_03bb4ffa:

    # mc "Oh, right, {w}that's actually the other reason Yui sent me here."
    mc "Ох, так, {w}це, власне, інша причина, чому Юї відправила мене сюди."

# game/game/hana_events.rpy:133
translate ukrainian hana_talk_95064381:

    # h "Yes, I need to make sure the village's savior is in good health."
    h "Так, мені треба переконатися, що рятівник нашого селища почувається добре."

# game/game/hana_events.rpy:134
translate ukrainian hana_talk_22ed364c:

    # t "Savior...?"
    t "Рятівник...?"

# game/game/hana_events.rpy:136
translate ukrainian hana_talk_1fe5ecca:

    # h "Shika, {w}can you come here for a moment?"
    h "Шико, {w}підійдеш, будь ласка, на хвильку?"

# game/game/hana_events.rpy:137
translate ukrainian hana_talk_0287578a:

    # s "Yeees~"
    s "Тааак~"

# game/game/hana_events.rpy:140
translate ukrainian hana_talk_f6c71214:

    # h "You can stop spying on our guest and come help me."
    h "Могла б ти перестати підглядати за нашим гостем і прийти допомогти мені."

# game/game/hana_events.rpy:144
translate ukrainian hana_talk_82928cac:

    # s "{sc=1}{outlinecolor=#000000}{size=-8}Gigh..."
    s "{sc=1}{outlinecolor=#000000}{size=-8}Гімх..."

# game/game/hana_events.rpy:146
translate ukrainian hana_talk_31c2f7fa:

    # s "Y{w}-Yees... Doctor..."
    s "Т{w}-Таак... Лікарко..."

# game/game/hana_events.rpy:152
translate ukrainian hana_talk_fac88981:

    # mc "Could you explain why I'm considered \"so weird\" in this village?"
    mc "Не поясниш мені, будь ласка, чому всі у цьому селищі вважають мене «таким дивним»?"

# game/game/hana_events.rpy:153
translate ukrainian hana_talk_75950370:

    # mc "Everyone keeps staring at me, and Yui also said something strange about Ryoko..."
    mc "Усі постійно витріщаються, а Юї також казала щось дивне про Рьоко..."

# game/game/hana_events.rpy:158
translate ukrainian hana_talk_20e3e160:

    # h "Shika, you take the bottom half. I'll take the top."
    h "Шико, ти бери за верх. А я — за низ."

# game/game/hana_events.rpy:159
translate ukrainian hana_talk_701d2464:

    # mc "What!?"
    mc "Га!?"

# game/game/hana_events.rpy:161
translate ukrainian hana_talk_f9956746:

    # s "Understood."
    s "Прийнято."

# game/game/hana_events.rpy:162
translate ukrainian hana_talk_f8aa9a63:

    # mc "Shika?"
    mc "Шика?"

# game/game/hana_events.rpy:164
translate ukrainian hana_talk_515bc060:

    # t "What's going on?"
    t "Що відбувається?"

# game/game/hana_events.rpy:166
translate ukrainian hana_talk_53faae66:

    # h "Relax... {w}Just relax and leave everything to me. Ufufu~"
    h "Спокійно... {w}Просто розслабся і довір усе мені. Ухуху~"

# game/game/hana_events.rpy:169
translate ukrainian hana_talk_d20500e0:

    # t "Finally... {w}Mother... I'm becoming a man."
    t "Нарешті... {w}Мамо... я зараз стану чоловіком."

# game/game/hana_events.rpy:170
translate ukrainian hana_talk_7070242e:

    # t "And not just with one, but with two beautiful girls..."
    t "І не з однією, а аж з двома красивими дівчатами..."

# game/game/hana_events.rpy:173
translate ukrainian hana_talk_2b35b6fe:

    # mc "..."
    mc "..."

# game/game/hana_events.rpy:174
translate ukrainian hana_talk_4faba10f:

    # t "Why aren't they doing anything?"
    t "Чому вони нічого не роблять?"

# game/game/hana_events.rpy:176
translate ukrainian hana_talk_03fb3e88:

    # mc "Mmm?"
    mc "Ммм?"

# game/game/hana_events.rpy:178
translate ukrainian hana_talk_c68d8bd5:

    # t "Why is everything glowing?"
    t "Що це за сяйво?"

# game/game/hana_events.rpy:179
translate ukrainian hana_talk_10d92692:

    # t "Is this... {w}magic?"
    t "Це... {w}магія?"

# game/game/hana_events.rpy:181
translate ukrainian hana_talk_f7c1fdde:

    # h "It looks like you've made a full recovery, {w}and in just a few days."
    h "Видно, ти повністю одужав, {w}і всього за кілька днів."

# game/game/hana_events.rpy:183
translate ukrainian hana_talk_e1ea158a:

    # s "How is that possible, Doctor? He was practically dying when he got here!"
    s "Як це можливо, Лікарко? Він же був при смерті, коли його сюди принесли!"

# game/game/hana_events.rpy:184
translate ukrainian hana_talk_4ede8e9c:

    # mc "{size=-6}{i}Gulp...*"
    mc "{size=-6}{i}*Ковть...*"

# game/game/hana_events.rpy:186
translate ukrainian hana_talk_314864ac:

    # h "[mc] might have rapid regeneration."
    h "Мабуть, у [mc] прискорена регенерація."

# game/game/hana_events.rpy:187
translate ukrainian hana_talk_99126473:

    # h "A rare trait, very few people have it."
    h "Рідкісна особливість, мало в кого вона є."

# game/game/hana_events.rpy:188
translate ukrainian hana_talk_d1d92341:

    # t "Or maybe... {w}the blessing of a certain goddess."
    t "Ну, або... {w}благословіння певної богині."

# game/game/hana_events.rpy:189
translate ukrainian hana_talk_bcc0fcf8:

    # t "But I can't say that out loud..."
    t "Але я не казатиму цього вголос..."

# game/game/hana_events.rpy:191
translate ukrainian hana_talk_7ed621ed:

    # h "This is fascinating. It's like nothing ever happened to you."
    h "Це просто неймовірно. Виглядає так, ніби з тобою нічого й не сталося."

# game/game/hana_events.rpy:193
translate ukrainian hana_talk_d8caab6d:

    # t "Yeah... {w}very fascinating indeed..."
    t "Ага... {w}справді неймовірно, згоден..."

# game/game/hana_events.rpy:194
translate ukrainian hana_talk_044b7416:

    # s "{size=-10}What's that? {w}There's a bulge in his pants..."
    s "{size=-10}Що це? {w}У нього щось випирає у штанях..."

# game/game/hana_events.rpy:199
translate ukrainian hana_talk_ddad5f46:

    # h "Let me tell you a story, [mc]."
    h "Дозволь мені розповісти тобі історію, [mc]."

# game/game/hana_events.rpy:201
translate ukrainian hana_talk_3a34d891:

    # h "A long time ago, peace reigned over these lands."
    h "Давним-давно на цих землях панував мир."

# game/game/hana_events.rpy:203
translate ukrainian hana_talk_4c280e2f:

    # h "There were no wars, and villages helped each other."
    h "Не було війн, а селища допомагали одне-одному."

# game/game/hana_events.rpy:205
translate ukrainian hana_talk_51565cbb:

    # h "Until one day, a kingdom decided to declare war on anyone who stood in its way."
    h "Аж поки одного дня королівство вирішило оголосити війну усім, хто стане на його заваді."

# game/game/hana_events.rpy:207
translate ukrainian hana_talk_9b3fd942:

    # h "Innocent people died, villages were destroyed, and those who survived were turned into slaves."
    h "Невинні люди гинули, а села горіли. Усіх, хто зміг вижити, перетворили на рабів."

# game/game/hana_events.rpy:209
translate ukrainian hana_talk_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/game/hana_events.rpy:210
translate ukrainian hana_talk_a41c1663:

    # h "Until one day, a girl appeared out of nowhere. She stood up against the corrupt king and ended the war."
    h "Аж раптом, ніби нізвідки, з'явилася дівчина. Вона виступила проти корумпованого короля і поклала край війні."

# game/game/hana_events.rpy:211
translate ukrainian hana_talk_accf9c45:

    # t "Why does my chest feel warm hearing this...?"
    t "Чому я відчуваю таке приємне тепло у грудях, коли це чую...?"

# game/game/hana_events.rpy:213
translate ukrainian hana_talk_5c34d83a:

    # h "She was the strongest of all. And with those who followed her, she built this village."
    h "Вона була найсильнішою з усіх. І разом із тими, хто пішов за нею, вона заснувала це селище."

# game/game/hana_events.rpy:215
translate ukrainian hana_talk_bf8afc93:

    # h "But one day... she vanished without a trace."
    h "Але одного дня... вона зникла, й сліду не залишила."

# game/game/hana_events.rpy:217
translate ukrainian hana_talk_19063c06:

    # h "There are still corrupt nobles who follow in the footsteps of that cursed king, seeking to enslave others for vanity."
    h "Досі існують корумповані дворяни, які йдуть слідами того клятого короля, прагнучи через власну пиху поневолити інших."

# game/game/hana_events.rpy:219
translate ukrainian hana_talk_094815dc:

    # h "And the ones they covet the most are..."
    h "А найбільш жаданими для них є..."

# game/game/hana_events.rpy:224
translate ukrainian hana_talk_2d1e466e:

    # h "The demons..."
    h "Демони..."

# game/game/hana_events.rpy:225
translate ukrainian hana_talk_ca977c67:

    # t "Ryoko..."
    t "Рьоко..."

# game/game/hana_events.rpy:227
translate ukrainian hana_talk_068ce62e:

    # t "So that's why everyone looked at me like that... Only nobles have slaves. I just showed up with Ryoko out of nowhere..."
    t "Ось чому всі так на мене дивилися... Рабів мають лише дворяни. А я просто з'явився з Рьоко нізвідки..."

# game/game/hana_events.rpy:229
translate ukrainian hana_talk_da56f61b:

    # mc "But why demons, specifically?"
    mc "Але чому саме демони?"

# game/game/hana_events.rpy:231
translate ukrainian hana_talk_2ad5b84b:

    # h "That... we still don't know."
    h "Якби ж... ми тільки знали."

# game/game/hana_events.rpy:233
translate ukrainian hana_talk_855f3fe8:

    # mc "And... why haven't I seen any men in the village since I got here?"
    mc "А ще... чому я досі не бачив жодного чоловіка у цьому селищі?"

# game/game/hana_events.rpy:235
translate ukrainian hana_talk_4d67de9b:

    # s "That's because of the contract, right Doctor?"
    s "Це ж через контракт, правда, Лікарко?"

# game/game/hana_events.rpy:237
translate ukrainian hana_talk_5eaa51d3:

    # h "Yes..."
    h "Так..."

# game/game/hana_events.rpy:239
translate ukrainian hana_talk_2af076c6:

    # s "When \"she\" disappeared, we were left at the mercy of the nobles."
    s "Коли «вона» зникла, ми опинилися в повній залежності від дворян."

# game/game/hana_events.rpy:241
translate ukrainian hana_talk_d46b3b67:

    # s "All the men left in exchange for the deal."
    s "Усіх чоловіків відправили у вигнання як частину угоди."

# game/game/hana_events.rpy:243
translate ukrainian hana_talk_11fe991f:

    # mc "And what was the deal?"
    mc "Що це за угода?"

# game/game/hana_events.rpy:245
translate ukrainian hana_talk_3d3baa63:

    # h "The contract was simple: no girl from this village would be enslaved."
    h "Контракт простий: жодна дівчина з цього селища не стане рабинею."

# game/game/hana_events.rpy:247
translate ukrainian hana_talk_5130675e:

    # mc "And have they honored it?"
    mc "І чи дотрималися вони його?"

# game/game/hana_events.rpy:255
translate ukrainian hana_talk_2fded262:

    # h "..."
    h "..."

# game/game/hana_events.rpy:256
translate ukrainian hana_talk_98f83d1a:

    # h "Every time a girl leaves this village... she never comes back."
    h "Кожна дівчина, що виходила за межі селища... ніколи так і не верталася назад."

# game/game/hana_events.rpy:258
translate ukrainian hana_talk_b20ee1b4:

    # h "On one side, bandits sent by the nobles. On the other, wolves waiting in the forest."
    h "По один бік — розбійники, заслані дворянами. По інший — вовки, що мешкають у лісі."

# game/game/hana_events.rpy:259
translate ukrainian hana_talk_3cc592f0:

    # t "That's why there were three wolves at the exit... I knew it wasn't random."
    t "Ось чому біля виходу стояли три вовки... Знав, що це не випадково."

# game/game/hana_events.rpy:262
translate ukrainian hana_talk_9895039e:

    # s "{sc=1}{outlinecolor=#000000}{size=-8}{b}Snoring~"
    s "{sc=1}{outlinecolor=#000000}{size=-8}{b}*Хрррр~*"

# game/game/hana_events.rpy:263
translate ukrainian hana_talk_f449d236:

    # s "{size=-8}{i}What are you hiding there, [mc]... let me see... {w}{sc=1}{outlinecolor=#000000}{size=-8}snoring*"
    s "{size=-8}{i}Що ти там ховаєш, [mc]... покажи-но... {w}{sc=1}{outlinecolor=#000000}{size=-8}*хрррр*"

# game/game/hana_events.rpy:264
translate ukrainian hana_talk_a20cefa7:

    # "..."
    "..."

# game/game/hana_events.rpy:269
translate ukrainian hana_talk_bdc3fd65:

    # h "But thanks to our new guest, we can go outside again!"
    h "Та з появою нашого нового гостя ми знову можемо вийти за межі селища!"

# game/game/hana_events.rpy:270
translate ukrainian hana_talk_b2b9e19d_1:

    # mc "What do you mean?"
    mc "Тобто?"

# game/game/hana_events.rpy:272
translate ukrainian hana_talk_a77555cf:

    # h "Let me explain, you didn't just kill three ordinary wolves."
    h "Дозволь мені пояснити: ти вбив не просто трьох звичайних вовків."

# game/game/hana_events.rpy:274
translate ukrainian hana_talk_39067ddc:

    # h "One of them was the Boss. An S-rank beast."
    h "Одним з них був їхній ватажок — S-ранговий звір."

# game/game/hana_events.rpy:275
translate ukrainian hana_talk_46f5f194:

    # mc "The one that attacked me after I defeated the others... {w}that explains why he was so much bigger..."
    mc "Той, що напав на мене, коли я поборов двох інших... {w}це пояснює його величезні розміри..."

# game/game/hana_events.rpy:276
translate ukrainian hana_talk_df2fba10:

    # t "And how he coordinated the others..."
    t "І те, як він спрямовував інших..."

# game/game/hana_events.rpy:278
translate ukrainian hana_talk_dc8c13c9:

    # h "Exactly. But now that he's gone, Yui and the other trained girls can finally go out and gather resources."
    h "Саме так. А тепер, коли його немає, Юї та інші підготовлені дівчата нарешті можуть вийти на пошуки ресурсів."

# game/game/hana_events.rpy:280
translate ukrainian hana_talk_6cff7e3f:

    # h "We didn't know what we were going to do this winter. But then you came along and changed everything."
    h "Ми вже гадали, що робитимемо цієї зими. Але тут з'явився ти та все змінив."

# game/game/hana_events.rpy:282
translate ukrainian hana_talk_41b7418a:

    # mc "But... it was just luck. I didn't know what I was doing."
    mc "Але... це чиста випадковість. Я тоді взагалі не тямив, що роблю."

# game/game/hana_events.rpy:284
translate ukrainian hana_talk_574ce2fb:

    # h "Still, on behalf of everyone here, {w}thank you."
    h "Однак усе одно від імені всіх нас {w}дякуємо тобі."

# game/game/hana_events.rpy:285
translate ukrainian hana_talk_aad90868:

    # mc "I-I don't know what to say..."
