# Перевизначення із виправленням для перекладу приставки
init 15 screen yui_h_mission:

    frame:
        at alpha_showani

        has viewport:
            area (850, 280, 900, 370)
            mousewheel True
            draggable True

        $ yhm1 = "{color=#E3CD5B}{b}•{/b}{/color} Visit {color=#FBE5A2}Yui{/color} in the evening."
        $ yhm2 = "{color=#E3CD5B}{b}•{/b}{/color} Go to {color=#FBE5A2}Yui's{/color} house and train with the village's female soldiers in the evening."
        $ yhm3 = "{color=#E3CD5B}{b}•{/b}{/color} Continue training the female soldiers."
        $ yhm3_sub = "/3 (Evening)"

        vbox:
            spacing 10
            frame:
                background Solid("#00000068")
                xpadding 10
                ypadding 5
                text "{size=-5}{i}{b}It looks like {color=#FBE5A2}Yui{/color} has a job for me." color "#D7BD99" font "fonts/Ebrima.ttf" size 31

            if not yui_visit:
                text "[yhm1!t]" color "#D7BD99" font "fonts/Ebrima.ttf" size 25
            if yui_visit:
                text "{s}" + "[yhm1!t]" + "{/s}" color "#907F67" font "fonts/Ebrima.ttf" size 25

            if yui_visit and not soldiers_training:
                text "[yhm2!t]" color "#D7BD99" font "fonts/Ebrima.ttf" size 25
            if soldiers_training:
                text "{s}" + "[yhm2!t]" + "{/s}" color "#907F67" font "fonts/Ebrima.ttf" size 25

            if soldiers_training and soldiers_count <= 2:
                text "[yhm3!t]" + "[soldiers_count][yhm3_sub!t]" color "#D7BD99" font "fonts/Ebrima.ttf" size 25
            if soldiers_count == 3:
                text "{s}" + "[yhm3!t]" + "[soldiers_count][yhm3_sub!t]" + "{/s}" color "#907F67" font "fonts/Ebrima.ttf" size 25